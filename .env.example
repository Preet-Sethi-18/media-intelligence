# All settings are optional: each value below is the built-in default, so an empty .env works.

# One database for BOTH the pipeline (`ingest`, the interface's "Run pipeline") and the API server.
MI_DATABASE_PATH=data/media_intelligence.sqlite3
# To browse the shipped final results instead (the README's ids refer to it), use this line instead.
# Viewing only: `ingest` refuses this database because it was built with older extraction rules.
# MI_DATABASE_PATH=examples/final.sqlite3

MI_CONFIG_PATH=config/sources.toml
MI_REPORT_DIR=reports
MI_LOG_LEVEL=INFO
MI_SPACY_MODEL=en_core_web_sm
MI_GROWTH_MIN_DELTA=3
MI_GROWTH_MIN_RATIO=0.5
# Optional local browser storage-state JSON. Never commit this file or paste its contents.
# MI_BROWSER_STATE_PATH=sessions/source-login.json
MI_BROWSER_HEADLESS=true
